flowchart TD
    subgraph S1["一、确定目标与内容"]
        A["人：明确受众、主题、平台<br/>确定画幅、时长、预算与预期效果"]
        B{"视频类型"}
        B1["产品宣传<br/>痛点 → 卖点 → 真实演示 → 行动引导"]
        B2["口播讲解<br/>问题 → 观点 → 例子 → 总结"]
        B3["技术布道<br/>问题 → 原理 → 操作演示 → 适用边界"]
        C["人提供事实与经验<br/>AI 辅助查证、组织和润色"]
        D["人确认制作脚本<br/>旁白正文 + 必要屏幕文字<br/>可用素材备注 + 关键画面要求<br/>普通段落可不备注，不必写死每个镜头"]

        A --> B
        B --> B1 & B2 & B3
        B1 & B2 & B3 --> C
        C --> D
    end

    subgraph S2["二、准备素材、配音与制作环境"]
        E["人 + Agent：整理素材<br/>截图、录屏、品牌图标、图表、角色动画<br/>记录路径、用途、可用片段与许可"]
        E1["按需制作缺失素材<br/>AI 生图或短动画、代码图解<br/>需要透明底时抠像并验证 Alpha 格式"]
        E2["人确认素材与段落的对应关系<br/>Agent 更新素材清单与脚本备注"]

        F{"配音方式"}
        F1["真人配音<br/>只朗读旁白正文<br/>录音后做必要的降噪、均衡与压缩"]
        F2["Agent 或程序提取纯旁白<br/>不把屏幕说明和素材备注交给 TTS"]
        F3["TTS：选择或设计音色<br/>先试读术语、中英混读与长句<br/>确认后合成旁白"]
        F4["人试听并修正<br/>读音、漏字、语气、语速与停顿<br/>得到本轮确认的旁白音轨"]

        G["工具：ASR 或音频文本对齐<br/>依据实际音轨生成时间戳<br/>例如 whisper.cpp"]
        G1["Agent 校对 + 人抽查<br/>参考旁白稿修正术语与错字<br/>按语义断句，输出匹配音轨的 SRT"]

        H["Agent：准备 Remotion 项目<br/>检查依赖、字体、预览与测试渲染<br/>以官方 Skill 打底，按需选择社区方案"]

        D --> E
        E --> E1 --> E2
        D --> F
        F -->|本人录音| F1
        F -->|语音合成| F2 --> F3
        F1 & F3 --> F4
        F4 --> G --> G1
        D -. "仅旁白正文用于字幕校对" .-> G1
        D --> H
    end

    subgraph S3["三、汇齐输入，制作短样片"]
        I["汇齐制作输入<br/>制作脚本 + 已确认素材<br/>旁白音轨 + 匹配的 SRT<br/>画幅、字体、背景与不可遗漏项"]
        J["Agent + AI：设计画面并编写 Remotion 代码<br/>脚本提供表达意图，素材提供画面内容<br/>音轨和 SRT 提供时间依据"]
        K["Remotion：渲染短样片<br/>长片先试约 1～2 分钟<br/>短片可选择代表性片段"]
        L{"人：样片是否符合预期？"}
        L1["给出具体修改意见<br/>字体、配色、构图、节奏、动画密度<br/>必要时再补充约束或更换风格参考"]

        E2 & G1 & H --> I
        I --> J --> K --> L
        L -->|不符合| L1 --> J
    end

    subgraph S4["四、制作全片与声音设计"]
        M["Agent：沿用样片标准扩展全片<br/>组织章节、录屏、图解、字幕与动画<br/>复用合适组件，不必整包照搬模板"]
        N["Agent：优先从个人音效库挑选<br/>缺口再到素材库检索<br/>BGM 与 SFX 分轨，保留来源和许可"]
        N1["人试听候选音效与配乐<br/>确认听感、用途与画面匹配<br/>不能把文字检索当成已经试听"]
        O["Remotion 与音频工具：合成预览版<br/>安排音效切点，调整音乐与旁白音量"]

        L -->|符合| M
        E2 --> N --> N1
        M & N1 --> O
    end

    subgraph S5["五、审片、修改与发布"]
        P{"人完整审片<br/>内容准确且无遗漏？素材正确？<br/>字幕清楚且同步？节奏与声音合适？"}
        P1["画面或素材问题<br/>调整对应场景、组件或素材"]
        P2["配音或停顿问题<br/>修改音轨，重新对齐受影响字幕<br/>同步更新后续场景与音效时间"]
        P3["音效或配乐问题<br/>替换素材、调整切点与音量"]

        Q["渲染正式成片<br/>按目标平台设置导出规格"]
        R["人：检查导出文件<br/>完整播放，核对裁切、字幕、声音与片尾"]
        T["准备封面、标题、简介与必要署名<br/>人工确认后发布"]
        U["归档可编辑工程、脚本、音轨与 SRT<br/>沉淀可复用动效、素材索引和音效库"]

        O --> P
        P -->|画面或素材需修改| P1
        P -->|声音时序需修改| P2
        P -->|音效或配乐需修改| P3
        P1 & P2 & P3 --> O
        P -->|通过| Q --> R
        R -->|发现问题| P
        R -->|通过| T --> U
        U -. "后续视频优先复用" .-> E
        U -. "积累个人音效库" .-> N
    end